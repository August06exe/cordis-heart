---
import { ClientRouter } from 'astro:transitions';
import ThemeToggle from '../components/ThemeToggle.astro';
import PagePager from '../components/PagePager.astro';
import { SITE_PAGES, SITE_WORDMARK, SITE_SUBTITLE, PREVIEW_BANNER, SNAPSHOT, ogKey } from '../data/site';
import '../styles/global.css';

interface Props {
  title: string;
  /** 页面 slug（'/' 或 'why' 等），用于导航高亮与 OG 图地址 */
  slug?: string;
  /** 章节名（如「序章 · 为什么」），预留页眉使用 */
  folio?: string;
  description?: string;
  /** 书页模式：左侧章节边栏 + 阅读栏（内容页用）；落地页传 false 或省略 */
  book?: boolean;
  /** 右侧「本页目录」轨：传非空数组即在阅读栏右侧渲染第三轨并吃掉宽屏右余白 */
  toc?: { id: string; label: string }[];
}

const { title, slug = '', description = 'Cordis 与 deepseek-harness 的思想图鉴，九页读懂时空可组装性。', book = false, toc } = Astro.props;

// here 与 SITE_PAGES 的 path 同口径（带尾斜杠），否则非首页导航 aria-current 永不命中
const here = slug === '/' ? '/' : `/${ogKey(slug)}/`;
const ogHref = `/og/${ogKey(slug)}.svg`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogHref} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- 字体自托管前暂用 Google Fonts CDN；自托管时同步改 global.css 的 --serif / --sans / --mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Noto+Sans+SC:wght@400;500;700&family=Noto+Serif+SC:wght@600;900&display=swap" rel="stylesheet" />
    <script is:inline>
      // 防闪白：置于 head，先于任何渲染定主题（10-docs/11-深色令牌定案.md 5.3）。
      (function () {
        var apply = function () {
          var t = null;
          try { t = localStorage.getItem('theme'); } catch (e) { /* 无存储权限时走 auto */ }
          if (t !== 'light' && t !== 'dark') {
            t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          document.documentElement.dataset.theme = t;
        };
        apply();
        document.addEventListener('astro:after-swap', apply);
      })();
      // [data-reveal] 的显影样式只在 js 可用时才隐藏内容（无 JS 内容不缺失）
      document.documentElement.classList.add('js');
    </script>
    <ClientRouter />
  </head>
  <body>
    <header class="topbar">
      <a class="mark" href="/">
        <b>{SITE_WORDMARK}</b>
        <span>{SITE_SUBTITLE}</span>
      </a>
      <div class="spacer"></div>
      <a class="tlink" href="/#toc">目录</a>
      <a class="tlink" href="/sandbox/">沙盒</a>
      <ThemeToggle />
    </header>

    {book ? (
      <div class={`book-shell${toc && toc.length ? ' has-toc' : ''}`}>
        <aside class="sidebar" aria-label="全书章节">
          <p class="side-head">全书</p>
          {SITE_PAGES.map((page) => (
            <a class="side-link" href={page.path} aria-current={page.path === here ? 'page' : undefined}>
              <span>{page.nav}</span>
            </a>
          ))}
          <p class="side-head">附</p>
          <a class="side-link" href="/#toc"><span>全书目录</span></a>
        </aside>
        {toc && toc.length > 0 ? (
          <div class="content-zone">
            <main class="reading">
              <slot />
              {/* 章节翻页器（基座）：book 壳阅读栏底部自动追加；slug 缺省时不渲染 */}
              {slug && <PagePager slug={slug} />}
            </main>
            <nav class="page-toc" aria-label="本页目录">
              <p class="toc-cap">本页目录</p>
              {toc.map((item) => (
                <a href={`#${item.id}`}>{item.label}</a>
              ))}
            </nav>
          </div>
        ) : (
          <main class="reading">
            <slot />
            {slug && <PagePager slug={slug} />}
          </main>
        )}
      </div>
    ) : (
      <main>
        <slot />
      </main>
    )}

    <footer class="foot">
      <span>DSH 的心脏 · Cordis 思想图鉴</span>
      <span>{PREVIEW_BANNER} 快照 {SNAPSHOT}</span>
    </footer>

    <script>
      // 全站一次性引导：主题切换与带走物复制用事件委托（跨 View Transitions 存活），
      // 页面级初始化挂 astro:page-load（首次加载与每次换页都会触发）。
      import { initReveals, destroyScenes, ScrollTrigger } from '../scripts/motion';

      function syncToggleLabel(): void {
        const btn = document.querySelector<HTMLElement>('[data-theme-toggle]');
        if (!btn) return;
        const dark = document.documentElement.dataset.theme === 'dark';
        btn.textContent = dark ? '深色' : '浅色';
        btn.setAttribute('aria-pressed', String(dark));
        btn.setAttribute('aria-label', `切换主题，当前${dark ? '深色' : '浅色'}`);
      }

      document.addEventListener('click', (event) => {
        const target = event.target as HTMLElement;

        const toggle = target.closest<HTMLElement>('[data-theme-toggle]');
        if (toggle) {
          const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
          document.documentElement.dataset.theme = next;
          // 切换组件只做两件事：写 localStorage 与同步 dataset.theme（定案 5.3）
          try { localStorage.setItem('theme', next); } catch { /* 隐私模式：仅本次会话生效 */ }
          syncToggleLabel();
          return;
        }

        const copyBtn = target.closest<HTMLElement>('[data-takeaway-copy]');
        if (copyBtn) {
          const body = copyBtn.closest('.takeaway')?.querySelector<HTMLElement>('.takeaway-body');
          if (!body) return;
          navigator.clipboard
            ?.writeText(body.innerText.trim())
            .then(() => {
              copyBtn.textContent = '已复制';
              copyBtn.classList.add('is-copied');
              window.setTimeout(() => {
                copyBtn.textContent = copyBtn.dataset.label ?? '复制';
                copyBtn.classList.remove('is-copied');
              }, 2000);
            })
            .catch(() => { /* 剪贴板不可用时静默，文案仍在页面上可手选 */ });
        }
      });

      document.addEventListener('astro:page-load', () => {
        syncToggleLabel();
        initReveals();
        // 换页与字体加载都可能改变版面高度，刷新 ScrollTrigger 测量
        ScrollTrigger.refresh();
      });
      document.addEventListener('astro:before-swap', () => {
        destroyScenes();
      });
    </script>
  </body>
</html>
