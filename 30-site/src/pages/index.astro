---
import Base from '../layouts/Base.astro';
import Unplug from '../components/demos/Unplug.astro';
import { CHAPTERS, PARTS, href, PAPER_URL } from '../data/book';
const parts = (['A', 'B', 'C', 'X'] as const).map((p) => ({ name: PARTS[p], list: CHAPTERS.filter((c) => c.part === p) }));
---
<Base title="CORDIS · DSH 的心脏 —— 一本拆开 Cordis 论文的小书">
  <main class="land">
    <section class="hero">
      <div class="hero-text">
        <p class="kicker">DeepSeek dsh 背后的那篇论文 · 拆开讲的小书</p>
        <h1>软件一边跑，<br />一边换零件，<br />凭什么<span class="hl">不散架</span>？</h1>
        <p class="hero-lede">今年 8 月，DeepSeek 开源了 dsh，七周拿下 24 万 star。它把模型、工具、会话记录，连 AI 的思考循环本身，都做成了随时能拔、随时能换的插件。撑住这一切的，是一个叫 Cordis 的框架，和一篇 92 页的论文。</p>
        <p class="hero-sub">这本小书把那篇论文拆开讲给你。不用会编程：每个思想配一个能亲手点的演示，读完带走几条能直接发给 AI 的规矩。</p>
        <div class="hero-cta">
          <a class="btn is-solid" href="/origin/">从第一章读起 →</a>
          <a class="btn" href="/paper/">只有 5 分钟：读一页纸版</a>
        </div>
        <p class="hero-by">论文：Yifan Shi（石逸凡）、Wei Zhang、Tianyi Cui · 北京大学 &amp; DeepSeek-AI · <a href={PAPER_URL} target="_blank" rel="noopener">arXiv:2608.25512</a></p>
      </div>
      <figure class="plate hero-plate">
        <div class="plate-frame"><img src="/images/web/I-01.jpg" alt="一颗机械心脏，其中一个腔室模块正被吊起更换" width="900" height="1200" fetchpriority="high" /></div>
        <figcaption><b>题图</b>换了零件，心跳照旧。</figcaption>
      </figure>
    </section>

    <section class="facts" aria-label="几个数字">
      <div><b>241,568</b><span>dsh 的 star，开源七周（2026-10-01）</span></div>
      <div><b>4,000+</b><span>Koishi 社区插件，和 dsh 用同一颗心脏</span></div>
      <div><b>2019</b><span>这颗心脏开始跳的年份</span></div>
      <div><b>92 页</b><span>论文全文，这本书替你读完</span></div>
    </section>

    <section class="block">
      <p class="kicker">先玩十秒</p>
      <h2>整本书，都在回答这一个画面</h2>
      <p class="block-lede">把一个插件拔掉之后，系统里还剩什么？先自己点一遍。后面十章讲的，就是它为什么能做到、怎么做到、你怎么借过去。</p>
      <div class="demo-wrap"><Unplug /></div>
    </section>

    <section class="block" id="toc">
      <p class="kicker">全书目录 · 十章加一个附录</p>
      <h2>三种读法，挑一种</h2>
      <p class="block-lede routes">只有 5 分钟：读 <a href="/paper/">03 一页纸</a>。想弄懂原理：从 <a href="/origin/">01</a> 顺着读到 08，每章一个演示。只想拿去用：直接去 <a href="/steal/">09 抄作业</a>。</p>
      <div class="toc-book">
        {parts.map(({ name, list }) => (
          <div class="toc-part">
            <div class="toc-pname">{name}</div>
            <div class="toc-rows">
              {list.map((c) => (
                <a class="toc-row" href={href(c.slug)}>
                  <img src={c.icon} alt="" width="600" height="600" loading="lazy" />
                  <span class="toc-no">{c.no}</span>
                  <span class="toc-t"><b>{c.title}</b><span>{c.blurb}</span></span>
                  <span class="toc-min">{c.minutes} 分钟 →</span>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="band">
      <div>
        <p class="kicker">准备好了</p>
        <h2>从一颗跑了快七年的心脏讲起。</h2>
      </div>
      <a class="btn is-solid" href="/origin/">第 01 章 · 由来 →</a>
    </section>
  </main>
</Base>

<style>
  .land { max-width: 1240px; width: 100%; margin: 0 auto; padding: 0 var(--gutter) 40px; }
  .hero { display: grid; grid-template-columns: minmax(0, 1fr) minmax(280px, 400px); gap: 40px 72px; align-items: center; padding: 64px 0 56px; }
  .hero h1 { margin: 22px 0 26px; font-size: clamp(40px, 5vw, 64px); line-height: 1.18; letter-spacing: -0.02em; color: var(--text); }
  .hero h1 .hl { color: var(--ink); }
  .hero-lede { max-width: 34em; font-size: 18.5px; line-height: 1.85; }
  .hero-sub { max-width: 34em; margin-top: 14px; color: var(--text-2); }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 14px; margin: 32px 0 22px; }
  .hero-by { font: 400 12.5px/1.7 var(--mono); color: var(--text-2); }
  .hero-by a { color: var(--ink); }
  .facts { display: grid; grid-template-columns: repeat(4, 1fr); border-block: 2px solid var(--ink); }
  .facts div { padding: 18px 20px 20px; display: flex; flex-direction: column; gap: 6px; }
  .facts div + div { border-left: 1px solid var(--ink-30); }
  .facts b { font: 900 32px/1.1 var(--serif); color: var(--ink); font-variant-numeric: tabular-nums; }
  .facts span { font-size: 13.5px; line-height: 1.6; color: var(--text-2); }
  .block { padding-top: 88px; }
  .block h2 { margin: 12px 0 14px; font-size: clamp(28px, 3vw, 38px); color: var(--text); }
  .block-lede { max-width: 40em; color: var(--text); }
  .routes a { color: var(--ink); font-weight: 700; text-underline-offset: 4px; }
  .demo-wrap { margin-top: 30px; }
  .toc-book { margin-top: 30px; border-top: 2px solid var(--ink); }
  .toc-part { display: grid; grid-template-columns: 180px minmax(0, 1fr); gap: 0 28px; border-bottom: 1px solid var(--rule-2); }
  .toc-pname { padding: 22px 0; font: 900 16px/1.5 var(--serif); color: var(--ink); }
  .toc-row { display: grid; grid-template-columns: 56px 36px minmax(0, 1fr) auto; align-items: center; gap: 0 16px; padding: 14px 10px 14px 0; color: var(--text); text-decoration: none; transition: background-color 0.15s; }
  .toc-row + .toc-row { border-top: 1px solid var(--rule); }
  .toc-row img { width: 56px; height: 56px; border: 1.5px solid var(--ink); background: #fff; transition: transform 0.15s var(--ease), box-shadow 0.15s var(--ease); }
  .toc-row:hover { background: var(--ink-04); }
  .toc-row:hover img { transform: translate(-2px, -2px); box-shadow: 3px 3px 0 var(--ink-30); }
  .toc-no { font: 500 14px/1 var(--mono); color: var(--ink); }
  .toc-t b { display: block; font: 900 18px/1.5 var(--serif); }
  .toc-t span { display: block; font-size: 14.5px; line-height: 1.65; color: var(--text-2); }
  .toc-min { font: 400 12.5px/1 var(--mono); color: var(--text-2); white-space: nowrap; }
  .toc-row:hover .toc-min, .toc-row:hover .toc-t b { color: var(--ink); }
  .band { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 20px; margin-top: 96px; padding: 34px 36px; border: 2px solid var(--ink); box-shadow: var(--shadow); }
  .band h2 { margin-top: 8px; font-size: clamp(24px, 2.6vw, 32px); color: var(--text); }
  @media (prefers-reduced-motion: no-preference) {
    .hero-text > * { animation: rise 0.7s var(--ease-out) both; }
    .hero-text > :nth-child(2) { animation-delay: 0.08s; }
    .hero-text > :nth-child(3) { animation-delay: 0.16s; }
    .hero-text > :nth-child(n + 4) { animation-delay: 0.24s; }
    .hero-plate .plate-frame { animation: press 1.1s var(--ease-out) 0.15s both; }
    .hero-plate img { animation: ink 1.1s var(--ease-out) 0.15s both; }
  }
  @keyframes rise { from { opacity: 0; transform: translateY(14px); } }
  @keyframes press { from { box-shadow: 0 0 0 var(--ink-14); transform: translate(8px, 8px); } }
  @keyframes ink { from { clip-path: inset(0 0 100% 0); } to { clip-path: inset(0 0 0 0); } }
  @media (max-width: 960px) {
    .hero { grid-template-columns: 1fr; padding-top: 40px; }
    .hero-plate { max-width: 340px; }
    .facts { grid-template-columns: 1fr 1fr; }
    .facts div:nth-child(3) { border-left: 0; }
    .facts div:nth-child(n + 3) { border-top: 1px solid var(--ink-30); }
    .toc-part { grid-template-columns: 1fr; }
    .toc-pname { padding: 18px 0 4px; }
    .toc-row { grid-template-columns: 48px 30px minmax(0, 1fr); }
    .toc-row img { width: 48px; height: 48px; }
    .toc-min { display: none; }
  }
</style>
