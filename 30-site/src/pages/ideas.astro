---
import BaseLayout from '../layouts/BaseLayout.astro';

import Takeaway from '../components/Takeaway.astro';
import SceneControls from '../components/SceneControls.astro';
import Demo01Scene from '../components/ideas/Demo01Scene.astro';
import Demo02Scene from '../components/ideas/Demo02Scene.astro';
import Demo03Scene from '../components/ideas/Demo03Scene.astro';
import Figure01 from '../components/ideas/Figure01.astro';
import SandboxScene from '../components/ideas/SandboxScene.astro';

// 文案照录 30-site/src/content/pages/ideas.md（新声音定稿，一字不改；正文含
// 加粗与「举例子」引文块，均按稿内标记原样落地）。
// 视觉基准：50-design/07-DesignRead-v2.md（M4.5，覆盖 v1 全部视觉条款）：
// · 正文 17.5px / 1.9 / 100% 实墨；小字图注统一 14px / 墨 .78（唯一降档）；
//   h1 52 / h2 28 / h3 20 / 大数字 48，serif 900 实墨，幽灵字禁用。
// · 节间距上下各 ≤72px（--section-gap）；卡片间距 --card-gap 22px；段落后 --space-p 18px。
// · 演示分镜与按钮定稿表用 .card 承载（v2 §4 卡片原语：2px 墨线 + 纸底 + 偏移实影）。
// · 「图 01 ·」「演示 0X」式题行的间隔号拆为图号与题名两栏（field-notes.astro 先例），
//   🎬 行全文入演示卡 demo-note；徽标计数取文稿 frontmatter。
// · 例子段（小周系列）保留原样：blockquote 结构不动，整段照录。
// 稿内稿务指针（按钮定稿表、动效分镜、演示深度状态行）为页务标注，随 .card 保留；
// 演示 01 / 02 为占位壳（本体属 M5），演示 03 循环本体在 ideas-motion.ts，
// 钩子 data-ideas-page / data-demo03 / data-scene-controls 未动。
//
// ── 2026-10-04 M47 改造（本章页壳与嵌图，文稿一字不改）────────────────────
// · BaseLayout 加 book={true}：左侧章节边栏 + 720px 阅读栏；PagePager 由 book 壳
//   按 slug="ideas" 自动挂在阅读栏底部（见 BaseLayout.astro:85-87 与组件头注）。
// · 阅读栏 608px 内容宽下，40/60 与 60/40 双栏 split 全部塌为单栏顺排
//   （DOM 本就文先、演示后）；分镜/按钮表两卡与尾区沙盒卡同步收单列。
// · m47 生图两主图（ideas-1/2，思想二断供与换源分镜，3:4）+ 两小卡（ideas-card1/2，
//   一词一画，1:1）当日通道阻断，以占位框 + 图注落位，prompt 落盘
//   public/images/m47/prompts/ 待通道恢复后按各 figure 内注释换 <img>。
// · 图号序列：文稿锚定的「图 01」在思想四不可改号，新主图顺次取图 02 / 图 03；
//   图注无转引数字，不出现【转引】标。
// · r1 回改（生图接入）：通道恢复后产出已落盘 public/images/web/——两主图
//   ideas-1 / ideas-2 与小卡 cards/ideas-card1 换入 <img>；ideas-card2 在
//   gen-ledger.json 标记生成失败，该小卡位保留 .ph 占位待补。
// ─────────────────────────────────────────────────────────────────────
---

<BaseLayout
  title="五个核心思想"
  slug="ideas"
  folio="五个核心思想"
  book={true}
  description="「让运行中的软件换零件，还能原样退回去」，这句话要站得住，得先经得起拆。论文把它拆成五个思想，每个思想都用同一个例子贯穿。"
  toc={[
    { id: 'ideas-s1', label: '可逆效应' },
    { id: 'ideas-s2', label: '响应式反效应' },
    { id: 'ideas-s3', label: '统一语境' },
    { id: 'ideas-s4', label: '独立性' },
    { id: 'ideas-s5', label: '四大保证' },
    { id: 'ideas-takeaway', label: '可带走物' },
  ]}
>
  <div class="ideas" data-ideas-page>

    <!-- 导语 -->
    <section class="lede" data-reveal>
      <h1 class="display">一句话，拆成五个思想</h1>
      <p class="sub">
        「让运行中的软件换零件，还能原样退回去」，这句话要站得住，得先经得起拆。论文把它拆成五个思想。每个思想都用同一个例子贯穿：<strong class="term">小周的
        Bot，装着天气、提醒、管理三个插件。</strong>
      </p>
      <div class="lede-meta">
        <span class="lede-note">五个思想的机制陈述可对回论文；小周贯穿例、生活类比与「所以呢」启示为本站演绎；本页无转引数字</span>
      </div>
    </section>

    <!-- 本章母题 · 一词一画小卡（ideas-card1 已接入 /images/web/cards/，1K 1:1）。
         动效卡：hover 平移 -4px,-4px + 阴影加深，transition 只挂 transform/box-shadow。
         ideas-card2 生成失败（gen-ledger.json），回旋箭头位暂留 .ph 占位待补。 -->
    <div class="mini-grid" data-reveal>
      <figure class="mini-card">
        <div class="ph ph-11" role="img" aria-label="一词一画占位：回旋箭头，撤销">
          <p class="ph-tag">生图待补</p>
          <p class="ph-ref">m47/prompts/ideas-card2.txt</p>
        </div>
        <figcaption class="mini-cap">
          <b>回旋箭头 · 撤销</b>
          <span>思想一 UNDO：一笔画出，原路回得去。</span>
        </figcaption>
      </figure>
      <figure class="mini-card">
        <img
          src="/images/web/cards/ideas-card1.jpg"
          alt="单墨钴蓝小卡：两脚插头正面大图，圆身网点纹，顶上缆线绕成一个松环"
          width="600"
          height="600"
          loading="lazy"
          decoding="async"
        />
        <figcaption class="mini-cap">
          <b>插头</b>
          <span>思想二 依赖：插得进，也拔得出。</span>
        </figcaption>
      </figure>
    </div>

    <!-- 思想一 可逆效应：40/60 左文右演示 -->
    <section class="sec" data-reveal>
      <div class="split split-a">
        <div class="text-col">
          <p class="sec-index">思想一</p>
          <h2 class="sec-title" id="ideas-s1">可逆效应</h2>
          <p class="sec-sub">每个改动自带撤销函数</p>
          <div class="body-copy">
            <p><strong class="term">问题</strong>：组件要在运行中装上、卸下，卸下后环境得回到它来之前。这事平时全凭自觉，忘了一句，就有一份资源悄悄漏掉。</p>
            <p><strong class="term">解法</strong>：组件对外界的每个改动叫「效应」，执行时当场交回两样：新状态 + 撤销函数。运行时把撤销函数串成链，卸载时调一次，环境整体复原；装载走效果迭代器，一步一交，坏一步只回滚到那一步。</p>
            <p><strong class="term">类比</strong>：装修留收据，退租时按相反顺序执行一遍。</p>
          </div>
          <blockquote class="example">
            <p class="ex-label"><strong>举例子</strong></p>
            <p>小周的天气插件装上时，注册了一个「每小时刷新天气」的定时任务。按老写法，卸载插件时这个任务经常被忘掉，变成无人认领的幽灵任务，永远在后台白跑。</p>
            <p>按可逆效应：注册任务的<strong>同一瞬间</strong>，就要交出「怎么注销它」的函数。卸载插件时，运行时拿着这条注销自动执行，幽灵任务根本不会存在。</p>
            <p>从此，「幽灵任务」在小周的项目里成了都市传说。</p>
          </blockquote>
          <div class="body-copy body-after">
            <p><strong class="term">所以呢</strong>：让你项目里每个工具调用、每次写记忆、每次动外部服务，都返回自己的回滚办法。</p>
          </div>
        </div>

        <figure class="demo-col">
          <div class="card demo-frame">
            <Demo01Scene />
            <p class="demo-note">🎬 演示 01「撤销堆栈」（可玩）：按「注册服务」，动作卡落栈；点撤销，逆序回放；「全部重置」一次清账。</p>
            <SceneControls scene="ideas-demo01" />
            <p class="demo-status">完整交互级 · 演示本体 M5 实现</p>
          </div>
          <figcaption class="cap"><span>演示 01</span><span class="rule" aria-hidden="true"></span><span>撤销堆栈</span></figcaption>
          <div class="spec-row">
            <div class="card btn-spec">
              <p class="btn-spec-title">演示按钮定稿</p>
              <table>
                <thead>
                  <tr><th scope="col">键名</th><th scope="col">按钮文案</th></tr>
                </thead>
                <tbody>
                  <tr><td><code>rename-title</code></td><td>改标题</td></tr>
                  <tr><td><code>register-service</code></td><td>注册服务</td></tr>
                  <tr><td><code>write-counter</code></td><td>写计数器</td></tr>
                </tbody>
              </table>
            </div>
            <div class="card storyboard">
              <p class="story-title">动效分镜</p>
              <ol>
                <li>点动作按钮，对应卡片落栈，一次过冲回弹；卡片自带「如何复原此处」回执签（对应 track：边干活边记账）。</li>
                <li>连按多次，栈叠高，回执签按顺序串成一条链（对应累加器）。</li>
                <li>点「撤销」，栈顶先出，逆序回放逆动作，每张约 300~400ms（LIFO，同 Ctrl+Z）。</li>
                <li>点「全部重置」，整链一次清账，环境回到进场之前（可靠性不变式；定理 5：逐步记账等于一次记完）。</li>
                <li>载入停第 0 帧显示「播放」；可暂停可重播；prefers-reduced-motion 时按钮改为「终态与拔除中态」淡切，内容不缺失。</li>
              </ol>
              <p class="story-impl">实现口径：只动 transform 与 opacity，60fps；prefers-reduced-motion 降级；播放器暴露 play() / pause() / restart()。</p>
            </div>
          </div>
        </figure>
      </div>
    </section>

    <!-- 思想二 响应式反效应：视觉 60/40 左演示右文；DOM 保持文稿顺序（文先、演示后） -->
    <section class="sec" data-reveal>
      <div class="split split-b">
        <div class="text-col">
          <p class="sec-index">思想二</p>
          <h2 class="sec-title" id="ideas-s2">响应式反效应</h2>
          <p class="sec-sub">依赖断供，自动歇业</p>
          <div class="body-copy">
            <p><strong class="term">问题</strong>：运行中依赖断了，代码要么报错，要么拿到空值崩在更远处；想提前防，就得手写监控代码盯上游。</p>
            <p><strong class="term">解法</strong>：组件开张前声明规格：我需要哪些键。环境每变一次，运行时对照规格分三类：前缺后齐就激活；前齐后缺就停用并恢复现场；其余不理会。</p>
            <p><strong class="term">类比</strong>：餐馆挂牌「本店需要水、电、燃气」。停水自动歇业，来水自动恢复，不派人查水表。</p>
          </div>
          <blockquote class="example">
            <p class="ex-label"><strong>举例子</strong></p>
            <p>小周的提醒插件声明依赖「数据库」。某天数据库维护下线：提醒插件<strong>没有报错</strong>，自动进入歇业；其他不碰数据库的插件（天气、管理）毫无感知，照常运行。数据库回来，提醒插件自动复工。</p>
            <p>老写法呢？数据库一断，提醒插件当场抛异常，管理插件因为碰了一下共享状态跟着崩，小周被半夜叫起来重启。（从那以后，他的手机睡觉时放客厅。）</p>
          </blockquote>
          <div class="body-copy body-after">
            <p><strong class="term">所以呢</strong>：让每个模块声明依赖。换数据库后端时，只重启真正用到数据库的那几个，其余原地不动。</p>
          </div>
        </div>

        <!-- 思想二 · 断供/换源分镜两联（ideas-1 / ideas-2 已接入 /images/web/，3:4）。
             2px 钴蓝框体 + 偏移实影，插在本节正文之后；图注无转引数字。 -->
        <div class="plate-duo" data-reveal>
          <figure class="plate">
            <div class="plate-frame">
              <img
                src="/images/web/ideas-1.jpg"
                alt="单墨钴蓝版画分镜：插头拔离插座悬在半空的缆线上，小方块模块顶的圆灯熄成稀疏网点的淡轮廓，手绘圈标出悬空插头"
                width="900"
                height="1200"
                loading="lazy"
                decoding="async"
              />
            </div>
            <figcaption class="plate-cap">
              <b>图 02 · 拔掉→熄灭</b>
              <span>插头离座悬在半空，灯只余一圈淡轮廓——断供那一刻，组件自动歇业。</span>
            </figcaption>
          </figure>
          <figure class="plate">
            <div class="plate-frame">
              <img
                src="/images/web/ideas-2.jpg"
                alt="单墨钴蓝版画分镜：旧源箱退役成网点淡影，插头坐进崭新的电池块源座，圆灯复明带短射线，手绘圈标出插头"
                width="900"
                height="1200"
                loading="lazy"
                decoding="async"
              />
            </div>
            <figcaption class="plate-cap">
              <b>图 03 · 换源→复明</b>
              <span>旧源退役成淡影，插头坐进新源，灯复明——换源复工，其余组件毫无感知。</span>
            </figcaption>
          </figure>
        </div>

        <figure class="demo-col">
          <div class="card demo-frame">
            <Demo02Scene />
            <p class="demo-note">🎬 演示 02「生命周期状态机」（可玩）：写键、删键、无关变化、断供连锁——看熄灭沿依赖线传两级。</p>
            <SceneControls scene="ideas-demo02" />
            <p class="demo-status">完整交互级 · 演示本体 M5 实现</p>
          </div>
          <figcaption class="cap"><span>演示 02</span><span class="rule" aria-hidden="true"></span><span>生命周期状态机</span></figcaption>
          <div class="spec-row">
            <div class="card btn-spec">
              <p class="btn-spec-title">演示按钮定稿</p>
              <table>
                <thead>
                  <tr><th scope="col">键名</th><th scope="col">按钮文案</th></tr>
                </thead>
                <tbody>
                  <tr><td><code>write-key</code></td><td>写键</td></tr>
                  <tr><td><code>delete-key</code></td><td>删键</td></tr>
                  <tr><td><code>neutral-change</code></td><td>无关变化</td></tr>
                  <tr><td><code>supply-cut</code></td><td>断供连锁</td></tr>
                </tbody>
              </table>
            </div>
            <div class="card storyboard">
              <p class="story-title">动效分镜</p>
              <ol>
                <li>环境每变一次（写键、删键），变化被强制送进分类器对照规格，一次不漏；组件自己不监控环境。</li>
                <li>前缺后齐：<code>activating</code>，组件开张，效果开始记账。</li>
                <li>前齐后缺：<code>deactivating</code>，进入「停用中」，清理逐笔走完才翻成歇业；这一拍刻意放慢，等待感是本演示的重点。</li>
                <li><code>neutral</code>：与该组件无关的变化直通，组件不理会。</li>
                <li>断供连锁深度固定 2：断供，直接依赖歇业，下游连锁熄灭（自由连线不做，那是沙盒的事）。</li>
                <li>四态按钮用户触发，可暂停可重播；prefers-reduced-motion 时三分类结果改为同屏并列展示。</li>
              </ol>
              <p class="story-impl">实现口径：只动 transform 与 opacity，60fps；prefers-reduced-motion 降级；播放器暴露 play() / pause() / restart()。</p>
            </div>
          </div>
        </figure>
      </div>
    </section>

    <!-- 思想三 统一语境：45/55 左文右循环演示（全宽正文占宽不足 60%，v2 §9-1 打回） -->
    <section class="sec" data-reveal>
      <div class="split split-c">
        <div class="text-col">
          <p class="sec-index">思想三</p>
          <h2 class="sec-title" id="ideas-s3">统一语境</h2>
          <p class="sec-sub">一切交互都走同一个门</p>
          <div class="body-copy">
            <p><strong class="term">问题</strong>：共享状态散落各处、谁都能绕过去动手的话，账就记不全，前两节的保证罩不住整个系统。</p>
            <p><strong class="term">解法</strong>：所有组件和环境的交互，都经过同一个对象「语境」：它记着当前状态、撤销链、依赖表。绕开门私接的状态怎么办？论文的补丁很妙：某分配器从语境外的计数器抽号，不合规——<strong>把那个计数器也绑成一个键，就合规了</strong>。</p>
            <p><strong class="term">类比</strong>：酒店前台的总账。动任何东西都记台账，谁也不许私下配钥匙；正因如此，退房验收才核得出「下一位客人察觉不出」。</p>
          </div>
          <blockquote class="example">
            <p class="ex-label"><strong>举例子</strong></p>
            <p>小周的管理插件想统计「今天处理了多少条命令」。它偷偷在自己代码里加了个计数变量：这就是绕过门的私接状态，卸载插件时没人知道要清它。</p>
            <p>改成合规做法：把这个计数器也注册成语境里的一个键。于是它自动获得三件套：有撤销、能被依赖、卸载时随账本一起清干净。（计数器本人：从黑户到转正。）</p>
          </blockquote>
          <div class="body-copy body-after">
            <p><strong class="term">所以呢</strong>：先想清楚你项目里「共享状态的唯一入口在哪」。入口立住了，互不干扰才能拆成逐键的本地条件去检查。</p>
          </div>
        </div>

        <figure class="demo-col" data-demo03>
          <div class="card demo-frame">
            <div class="demo-grid">
              <div class="demo-scene">
                <Demo03Scene />
              </div>
              <div class="demo-rail">
                <p class="demo-note">🎬 演示 03「万物过前台」（自动循环）：效应和登记两类方块流经同一座柜台，每过一枚，账本落一行账。</p>
                <SceneControls scene="ideas-demo03" />
                <p class="demo-status">循环动画级 · 进视口自动循环</p>
              </div>
            </div>
          </div>
          <figcaption class="cap"><span>演示 03</span><span class="rule" aria-hidden="true"></span><span>万物过前台</span></figcaption>
          <div class="card storyboard story-cols">
            <p class="story-title">动效分镜</p>
            <ol>
              <li>GSAP MotionPath 驱动，两类方块沿同一条路径流经同一座柜台。</li>
              <li>每过一枚，账本落一行账；账行词汇与演示卡 02 的三分类保持同一套，两个演示互相引用。</li>
              <li>循环播放：进视口开播、滚出视口即暂停；prefers-reduced-motion 定格首帧；保留重播入口。不与滚动耦合。</li>
              <li>循环本体 M4 实现，本稿出静帧与分镜。</li>
            </ol>
            <p class="story-impl">实现口径：只动 transform 与 opacity，60fps；prefers-reduced-motion 降级；播放器暴露 play() / pause() / restart()。</p>
          </div>
        </figure>
      </div>
    </section>

