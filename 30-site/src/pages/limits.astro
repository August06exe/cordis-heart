---
import BaseLayout from '../layouts/BaseLayout.astro';

import Takeaway from '../components/Takeaway.astro';

// 文案一字不改照录 30-site/src/content/pages/limits.md（新声音定稿，无【解读】行内标记）；
// 版式基准：50-design/07-DesignRead-v2.md（M4.5 唯一视觉基准）。
// §2 排版阶梯（正文 17.5px/1.9 实墨，h2 28 / h3 20 serif 900；h1 随 Book 壳阅读栏收档）；
// §3 间距验收线（节间距 ≤72px、卡片间距 20~24px、段落后 18px）；
// §4 卡片原语（.card = 2px 墨线 + 纸底 + 8px 偏移实影 + 20~24px 内边距，
// 六条边界条目与带走物五问均落为卡片；卡内以数字色块承载视觉）；
// 账页对照表保留但行距收紧（本页唯一编排时刻，仍由 src/scripts/limits-motion.ts 驱动）。
//
// 2026-10-04 M47 书页改造：
// · BaseLayout 开 book 壳（左侧章节边栏 + 阅读栏）；翻页器由 book 壳 + slug 自动挂载；
// · 原静态示意 SVG（GateFigure 语境之门）表达力弱于生图版式，撤下，由生图主图接替；
// · 四张生图已出（gpt-image，台账 public/images/m47/gen-ledger.json，failed: []）：
//   主图 /images/web/limits-1.jpg · limits-2.jpg（900×1200，3:4），
//   小卡 /images/web/cards/limits-card1.jpg · limits-card2.jpg（600×600，1:1）；
//   占位 .ph-box 已整块换成 <img>（width/height/alt/loading），图注不动；
// · 色彩纪律（正文去蓝令）：正文/卡内正文近黑（--text-body），钴蓝只落
//   标题、kicker、strong 重点、框线、图注编号与链接。
---

<BaseLayout
  title="边界与代价 · Cordis 思想图鉴"
  slug="limits"
  book={true}
  folio="边界与代价"
  description="这套范式有一笔进场费，名字叫纪律。六条边界清单、五个别用场景与采用前自查五问。"
  toc={[
    { id: 'limits-s2', label: '六条边界' },
    { id: 'limits-s3', label: '五个场景' },
    { id: 'selfcheck', label: '采用前自查五问' },
  ]}
>
  <div data-limits>
    <!-- 第一节 · 正文立骨，主图（图 01）压在正文之后；小卡网格（进场费/闹钟）收边 -->
    <section class="sect" aria-labelledby="limits-h1">
      <div class="wrap">
        <div class="s1-copy" data-reveal>
          <!-- nowrap 包住「什么时候别用」：断行只落在逗号后，属排版断行控制，不改一字 -->
          <h1 class="display" id="limits-h1">这套思想，<span class="nw">什么时候别用</span></h1>
          <!-- 徽标计数照录文稿 frontmatter「原文核实 3 ｜ 合理解读 3 ｜ 转引未核实 0」 -->
          <div class="s1-badges">
          </div>
          <h2 class="s1-deck">最大的成本，叫纪律</h2>
          <p class="body-copy">这套范式有一笔进场费。它的所有保证都建立在一个前提上：<strong>一切共享状态绑成键，一切交互走语境。</strong></p>
          <p class="body-copy">语境像一栋楼唯一的大门，保安只在这个门执勤；从窗户翻进来的状态，出了事没人赔。把它接进现有系统，动的是结构：共享状态要一件一件绑回键上。最危险的用法是走一半：一半进语境、一半留在外面，你会误以为整套系统都在保护之下，而真正没人管的，恰好是留下来的那一半。</p>
        </div>

        <!-- 图 01 · 主图（limits-1）：生图已出，900×1200 · 3:4 单墨钴蓝版画 -->
        <figure class="plate" data-reveal>
          <img
            class="plate-img"
            src="/images/web/limits-1.jpg"
            width="900"
            height="1200"
            alt="单墨钴蓝版画——一栋只有一个大门的楼，保安在大门登记进出；右上方一扇敞开的窗，一个状态正翻窗而入，无人过问"
            loading="lazy"
          />
          <figcaption class="fig-note plate-note">
            <span>图 01 · 唯一的大门</span>
            <span class="rule" aria-hidden="true"></span>
            <span>保安只认正门：经门进来的状态有人记账，翻窗进来的出了事没人赔。</span>
          </figcaption>
        </figure>

        <!-- 小卡网格 · 两张 1:1 小卡（进场费 / 闹钟），动效卡：hover 位移 + 阴影加深 -->
        <div class="mini-grid" data-reveal>
          <figure class="mini-card">
            <img
              class="card-img"
              src="/images/web/cards/limits-card1.jpg"
              width="600"
              height="600"
              alt="单墨钴蓝版画——一张打孔的进场门票，票根以撕孔线分离"
              loading="lazy"
            />
            <figcaption class="fig-note mini-note">
              <span>卡 01</span>
              <span class="rule" aria-hidden="true"></span>
              <span>进场费：票一打孔，这笔开销就付过了。</span>
            </figcaption>
          </figure>
          <figure class="mini-card">
            <img
              class="card-img"
              src="/images/web/cards/limits-card2.jpg"
              width="600"
              height="600"
              alt="单墨钴蓝版画——一只双铃闹钟正在响铃，双锤外扬"
              loading="lazy"
            />
            <figcaption class="fig-note mini-note">
              <span>卡 02</span>
              <span class="rule" aria-hidden="true"></span>
              <span>闹钟到点必响；响过之后对不对，它管不着。</span>
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- 第二节 · 六条边界：v2 §4 卡片原语（边界清单条目落卡），2 列栅格 -->
    <section class="sect" aria-labelledby="limits-s2">
      <div class="wrap">
        <div class="sect-head" data-reveal>
          <h2 class="sect-title" id="limits-s2">六条边界，逐条说清</h2>
        </div>
        <div class="boundary-grid" data-reveal>
          <article class="boundary card">
            <span class="no" aria-hidden="true">01</span>
            <div class="boundary-main">
              <h3>撤销的正确性仍由你负责</h3>
              <p class="body-copy">框架像闹钟，到点一定响；响过之后动作对不对，闹钟管不着。它防「忘了写清理」，防不了「写错了清理」。</p>
            </div>
          </article>
          <article class="boundary card">
            <span class="no" aria-hidden="true">02</span>
            <div class="boundary-main">
              <h3>内存状态不保留</h3>
              <p class="body-copy">字面动作是卸了重装。想留住状态，就把它搬进比组件更长寿的依赖里。</p>
            </div>
          </article>
          <article class="boundary card">
            <span class="no" aria-hidden="true">03</span>
            <div class="boundary-main">
              <h3>边界外收不回</h3>
              <p class="body-copy">数据一旦发出系统（写盘、发包），撤销函数就够不着了，只剩扣住不发，或事后补偿。</p>
            </div>
          </article>
          <article class="boundary card">
            <span class="no" aria-hidden="true">04</span>
            <div class="boundary-main">
              <h3>版本与命名是开放问题</h3>
              <p class="body-copy">依赖按名字连接，接口一漂、键名一撞，就是「连接成立但运行出错」：名字对上了，人对错了。</p>
            </div>
          </article>
          <article class="boundary card">
            <span class="no" aria-hidden="true">05</span>
            <div class="boundary-main">
              <h3>循环依赖查得出但拆着疼</h3>
              <p class="body-copy">能静态检出，不会死锁，只会永久休眠。拆开要新写胶水组件，十个缠在一起的组件，最坏要新写几十个。</p>
            </div>
          </article>
          <article class="boundary card">
            <span class="no" aria-hidden="true">06</span>
            <div class="boundary-main">
              <h3>证据是观察性的</h3>
              <p class="body-copy">只有一种生态、一种语言的实践，没有对照实验；Koishi 生产环境跑的还是上一代版本，论文讲的是下一代。</p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- 第三节 · 场景账页：表保留、行距收紧（v2 §3），逐条显影见 limits-motion.ts -->
    <section class="sect" aria-labelledby="limits-s3">
      <div class="wrap">
        <div class="sect-head" data-reveal>
          <h2 class="sect-title" id="limits-s3">五个场景，先问纪律，再问开销</h2>
        </div>
        <div class="ledger" data-ledger role="table" aria-label="场景与是否适用对照">
          <div class="ledger-head" role="row">
            <span role="columnheader">场景</span>
            <span role="columnheader">是否适用</span>
          </div>
          <div class="ledger-row" data-ledger-row role="row">
            <span class="l-scene" role="cell">一次性脚本、组件集合常年不动的工具</span>
            <p class="l-verdict" role="cell"><strong>不适用</strong>：纯开销</p>
          </div>
          <div class="ledger-row" data-ledger-row role="row">
            <span class="l-scene" role="cell">性能极度敏感且高频触碰共享状态的路径</span>
            <p class="l-verdict" role="cell"><strong>不适用</strong>：intercept 和 isolate 的成本还没有数字</p>
          </div>
          <div class="ledger-row" data-ledger-row role="row">
            <span class="l-scene" role="cell">真正的不可信代码</span>
            <p class="l-verdict" role="cell"><strong>不适用</strong>：能力检查拦不住绕过代理的恶意代码</p>
          </div>
          <div class="ledger-row" data-ledger-row role="row">
            <span class="l-scene" role="cell">团队没把握长期坚持「一切交互都走同一个入口」的纪律</span>
            <p class="l-verdict" role="cell"><strong>不适用</strong>：坚持不住，保证就停在纸面上</p>
          </div>
          <div class="ledger-row focal" data-ledger-row role="row">
            <span class="l-scene" role="cell"><span class="go-mark" aria-hidden="true"></span>自进化 agent harness（快速替换组件、拓扑频繁变动）</span>
            <p class="l-verdict" role="cell"><strong>适用</strong>：快速替换接住「拆得干净」，频繁变动接住「接得稳」</p>
          </div>
        </div>

        <!-- 图 02 · 主图（limits-2）：四叉一勾的自查单，压在场景账页之后；生图已出，900×1200 · 3:4 -->
        <figure class="plate" data-reveal>
          <img
            class="plate-img"
            src="/images/web/limits-2.jpg"
            width="900"
            height="1200"
            alt="单墨钴蓝版画——一张五行自查单，前四行右端的方框各打一个叉，末行方框单独打勾，钢笔刚离开勾选处"
            loading="lazy"
          />
          <figcaption class="fig-note plate-note">
            <span>图 02 · 五问自查单</span>
            <span class="rule" aria-hidden="true"></span>
            <span>四叉一勾：前四个场景先问纪律与开销，第五个才是这套范式的家。</span>
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- 带走物 · 采用前自查五问：v2 §4 卡片序列，复制按钮整段带走；
         标题只出现一次（Takeaway 卡题即节题，不设外层 h2 重复） -->
    <section class="sect" id="selfcheck" aria-label="可带走物 · 采用前自查五问">
      <div class="wrap">
        <div class="takeaway-slot" data-reveal>
          <Takeaway title="可带走物 · 采用前自查五问">
            <div class="check-seq">
              <article class="check">
                <span class="no" aria-hidden="true">01</span>
                <p class="q"><strong>共享状态能全部绑成语境键吗？</strong>有一条绕行（全局单例、模块级缓存），这条就不过。</p>
              </article>
              <article class="check">
                <span class="no" aria-hidden="true">02</span>
                <p class="q"><strong>组件真的需要运行中动态装卸吗？</strong>集合常年不动，开销一分都收不回来。</p>
              </article>
              <article class="check">
                <span class="no" aria-hidden="true">03</span>
                <p class="q"><strong>热路径会不会高频触碰共享状态？</strong>拿到实测数字之前，别把「应该不大」当结论。</p>
              </article>
              <article class="check">
                <span class="no" aria-hidden="true">04</span>
                <p class="q"><strong>要跑的代码里有不可信的吗？</strong>这套范式不替代独立沙箱。</p>
              </article>
              <article class="check">
                <span class="no" aria-hidden="true">05</span>
                <p class="q"><strong>团队真能长期坚持这条纪律吗？</strong>所有交互都走同一个入口，一条都不能漏——半途而废，比不用更危险。</p>
              </article>
            </div>
          </Takeaway>
        </div>
        <p class="check-out" data-reveal>整段发给 AI，让它对着你的代码库逐条回答。</p>
        <p class="end-row" data-reveal><a class="back-link" href="/">全书完 · 回到开头再滚一遍 ↑</a></p>
      </div>
    </section>

    <!-- 时效声明（文稿尾注照录） -->
    <section class="sect sect-note">
      <div class="wrap">
        <p class="footnote" data-reveal>时效声明：deepseek-harness 目前是 developer preview，项目自曝会有破坏性变更；本页引用的仓库与版本信息，快照于 2026-10。</p>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  // 页级动效：账页对照表逐条显影（本页唯一编排时刻），浏览器端模块（不能进 frontmatter，否则 SSR 预渲染会执行）
  import '../scripts/limits-motion';
</script>

<style>
  /* ── 节律（v2 §3：节间距 ≤72px，数字即验收线） ─────────────────────────
     M47 book 壳：本页落在 .reading 阅读栏（720px 栏 + 56px 栏内边距）里，
     原 1180px 双栏 .wrap 收为随栏全宽；页面左右缘由阅读栏统一负责。 */
  .sect { padding-block: 64px; }
  .sect + .sect { border-top: 1px solid var(--border); }
  .wrap { width: 100%; max-width: none; padding-inline: 0; }

  /* ── 第一节 ─────────────────────────────────────────────────────────── */
  .s1-copy { min-width: 0; }
  /* display 随 book 阅读栏收档：44~52 的落地页档在 608px 栏宽里放不下，
     收到与 .reading h1（34px）一族的 36~42px serif 900 实墨 */
  .display {
    font-size: clamp(36px, 3.2vw, 42px);
    line-height: 1.35;
    letter-spacing: .01em;
    max-width: 14em;
    margin-bottom: 18px;
    text-wrap: balance;
  }
  .s1-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 22px;
  }
  /* 节内 deck 走 v2 §2 h2 档：28px serif 900 实墨 */
  .s1-deck {
    font-size: 28px;
    letter-spacing: .02em;
    margin-bottom: var(--space-p);
  }
  /* 正文走 v2 §2 档：17.5px / 1.9 近黑（--text-body 指向 Book v3 --text） */
  .body-copy {
    font-size: 17.5px;
    line-height: 1.9;
    color: var(--text-body);
    max-width: 26em;
  }
  .body-copy strong { font-weight: 700; color: var(--ink); }
  .s1-copy .body-copy + .body-copy { margin-top: var(--space-p); }

  /* ── 生图版位（M47）：2px 钴蓝框体 + 8px 偏移实影，图注走 .fig-note ────
     版心重排（2026-10-03）：孤竖版统一「画|注」双格全宽（与 why 同口径），
     取消 400px 限宽；小卡 1:1 双卡 2 列吃满，不再 440px 限宽。 */
  .plate {
    width: 100%;
    margin: 40px 0 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: stretch;
    border: 2px solid var(--ink);
    background: var(--paper);
    box-shadow: 8px 8px 0 var(--ink-14);
  }
  .plate-note {
    margin: 0;
    padding: 18px 20px;
    border-left: 1px solid var(--border);
    align-self: center;
    flex-direction: column;   /* 双格右半竖排：标签行/说明行各占一行（横排 rule 是全宽形态的） */
    gap: 8px;
  }
  .plate-note .rule { display: none; }
  .plate-img,
  .card-img {
    display: block;
    width: 100%;
    height: auto;
  }
  .plate .plate-img {
    height: 100%;
    object-fit: cover;
    aspect-ratio: 3 / 4;
  }

  /* ── 小卡网格（M47 动效卡片）：1:1 小卡两张 2 列吃满，hover 位移 + 阴影加深 ──
     铁律：transition 只动 transform / box-shadow，不碰颜色与布局属性；
     位移 -4px/-4px，实影从 8px ink-.14 加深到 12px ink-.20。 */
  .mini-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--card-gap);
    margin-top: 40px;
  }
  .mini-card {
    min-width: 0;
    border: 2px solid var(--ink);
    background: var(--paper);
    box-shadow: 8px 8px 0 var(--ink-14);
    transition: transform .18s ease, box-shadow .18s ease;
  }
  .mini-card:hover {
    transform: translate(-4px, -4px);
    box-shadow: 12px 12px 0 var(--ink-20);
  }
  .mini-note {
    /* 卡内图注不吃 global .fig-note 的横排 rule（~200px 卡宽放不下）：
       标签行（钴蓝编号）+ 说明行（墨 .78），随卡片一起做 hover 位移 */
    display: block;
    margin: 0;
    padding: 10px 12px 12px;
    border-top: 1px solid var(--border);
    font-size: 12.5px;
    line-height: 1.8;
    letter-spacing: .06em;
  }
  .mini-note .rule { display: none; }
  .mini-note > span:first-child {
    display: block;
    font-weight: 700;
    letter-spacing: .18em;
    color: var(--ink);
    margin-bottom: 2px;
  }
  @media (prefers-reduced-motion: reduce) {
    .mini-card { transition: none; }
  }

  /* ── 节头 ───────────────────────────────────────────────────────────── */
  .sect-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px 32px;
    flex-wrap: wrap;
    margin-bottom: 26px;
  }
  /* 节标题走 v2 §2 h2 档：28px serif 900 实墨 */
  .sect-title {
    font-size: 28px;
    line-height: 1.4;
    letter-spacing: .02em;
  }

  /* ── 第二节 · 边界卡片（v2 §4：.card 原语，卡内数字色块承载视觉） ──────
     M47 book 壳：阅读栏 608px 栏宽下双栏卡只剩 ~190px 文字列，收为单栏纵向序列。
     卡片间距走 --card-gap（22px），内边距走 --card-pad（22px）。 */
  .boundary-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--card-gap);
    align-items: stretch;
  }
  .boundary {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: 14px;
    align-items: start;
  }
  .boundary .no,
  .check .no {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    flex: none;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--mono);
    font-weight: 500;
    font-size: 13px;
    letter-spacing: .08em;
    margin-top: 2px;
  }
  /* 卡题走 v2 §2 h3 档：20px serif 900 实墨（global h3 已定） */
  .boundary h3 { margin-bottom: 8px; letter-spacing: .02em; }
  .boundary .body-copy { max-width: none; }

  /* ── 第三节 · 账页对照表（行距收紧：22~34px → 15px） ─────────────────── */
  .ledger { border-top: 1px solid var(--border); }
  .ledger-row {
    position: relative;
    display: grid;
