---
/**
 * 图 01：语境是唯一的门（视觉稿 glossary.html:417-461 的生产化移植）。
 * 左「组件」积木立于墨 .14 基座，效应经唯一 gate 出去，反效应带依赖经同一道门进来，
 * 汇入右侧「语境 · 总账」长条。2px 墨线积木、1.6px 墨 .70 贝塞尔箭头，颜色全走令牌。
 * 新声音文稿不再携带图注句，本图形按纯装饰呈现（aria-hidden，信息由 14 张术语卡承担，
 * 见 07-DesignRead-v2 第 7 节：词典页视觉由卡片阵列本身承担，不强制插图）。
 */
---

<svg
  viewBox="0 0 780 440"
  aria-hidden="true"
  focusable="false"
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <marker
      id="glo-arrowhead"
      viewBox="0 0 10 10"
      refX="8"
      refY="5"
      markerWidth="7"
      markerHeight="7"
      orient="auto-start-reverse"
    >
      <path d="M0,0 L10,5 L0,10 Z" class="dg-arrow"></path>
    </marker>
  </defs>

  <g data-dg="curves">
    <path class="dg-curve" d="M 250 244 C 330 208, 430 232, 524 197" marker-end="url(#glo-arrowhead)"></path>
    <path class="dg-curve" d="M 536 300 C 430 268, 340 296, 294 333" marker-end="url(#glo-arrowhead)"></path>
    <text class="dg-note" x="262" y="196">效应 · 改动出去</text>
    <text class="dg-note" x="306" y="402">反效应 · 依赖进来</text>
  </g>

  <g data-dg="gate">
    <rect x="406" y="183" width="32" height="134" rx="16" class="dg-box"></rect>
    <text class="dg-index" x="422" y="172" text-anchor="middle">gate</text>
  </g>

  <g data-dg="component">
    <rect x="60" y="220" width="230" height="150" rx="10" class="dg-box"></rect>
    <text class="dg-index" x="76" y="244">component</text>
    <text class="dg-label" x="175" y="302">组件</text>
  </g>
  <rect class="dg-plinth" x="44" y="370" width="262" height="8" rx="4" data-dg="plinth"></rect>

  <g data-dg="context">
    <rect x="530" y="80" width="190" height="330" rx="10" class="dg-box"></rect>
    <text class="dg-index" x="546" y="104">context</text>
    <text class="dg-label" x="625" y="134">语境 · 总账</text>
    <line class="dg-rule" x1="552" y1="168" x2="698" y2="168"></line>
    <line class="dg-rule" x1="552" y1="203" x2="698" y2="203"></line>
    <line class="dg-rule" x1="552" y1="238" x2="698" y2="238"></line>
    <line class="dg-rule" x1="552" y1="273" x2="698" y2="273"></line>
    <line class="dg-rule" x1="552" y1="308" x2="698" y2="308"></line>
    <line class="dg-rule" x1="552" y1="343" x2="698" y2="343"></line>
  </g>
</svg>

<style>
  svg {
    width: 100%;
    height: auto;
    display: block;
  }
  .dg-box {
    fill: var(--paper);
    stroke: var(--ink);
    stroke-width: 2;
  }
  .dg-label {
    font-family: var(--sans);
    font-weight: 700;
    font-size: 15px;
    letter-spacing: .08em;
    fill: var(--ink);
    text-anchor: middle;
  }
  .dg-index {
    font-family: var(--mono);
    font-weight: 500;
    font-size: 10px;
    letter-spacing: .16em;
    fill: var(--ink);
    opacity: .8;
  }
  .dg-note {
    font-family: var(--sans);
    font-weight: 500;
    font-size: 13px;
    letter-spacing: .06em;
    fill: var(--ink);
    opacity: .78;
  }
  .dg-curve {
    fill: none;
    stroke: var(--ink-70);
    stroke-width: 1.6;
  }
  .dg-arrow {
    fill: var(--ink-70);
  }
  .dg-plinth {
    fill: var(--ink);
    opacity: .14;
  }
  .dg-rule {
    stroke: var(--ink);
    opacity: .2;
    stroke-width: 1;
  }
</style>
