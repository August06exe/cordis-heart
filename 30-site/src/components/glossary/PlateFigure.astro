---
/**
 * 词典页主图框（M47 嵌图规约）：2px 钴蓝框体 + 8px 偏移实影的 figure，
 * 内为 3:4 版画井（aspect-ratio）+ 图注（图号·标题 + 一句话说明），
 * 插在对应术语卡之后（grid 单元，随栅格半栏）。
 * 生图通道阻断期（2026-10-03，本机代理未运行，prompt 已落盘
 * public/images/m47/prompts/）渲染占位井：虚线内框 + 待补说明；
 * src 一旦补跑传入即替换为 <img>，框体与图注结构不动。
 * 图注文字属版式文案（非文稿正文）；本页快照无转引数字（frontmatter
 * 「转引未核实 0 · 本页无转引数字」），故图注不带【转引】标。
 */
interface Props {
  /** 图号，如 "1" */
  no: string;
  /** 图注标题（图号·标题 里的标题段） */
  title: string;
  /** 一句话说明 */
  caption: string;
  /** 占位期指向落盘 prompt，便于补跑对号 */
  promptFile?: string;
  /** 生图补跑后传入即替换占位 */
  src?: string;
  alt?: string;
  /** 版画井比例，默认竖版 3:4 */
  ratio?: string;
}

const { no, title, caption, promptFile, src, alt = title, ratio = '3 / 4' } = Astro.props;
const ratioLabel = ratio.replace(/\s*\/\s*/, ':');
---

<figure class="plate">
  <div class="well" style={`aspect-ratio: ${ratio}`}>
    {src ? (
      <img src={src} alt={alt} loading="lazy" />
    ) : (
      <div class="ph" role="img" aria-label={`${title}（生图待补占位）`}>
        <span class="ph-tag">占位 · 生图待补</span>
        <span class="ph-note">单色铜版画 {ratioLabel}</span>
        {promptFile && <span class="ph-file">{promptFile}</span>}
      </div>
    )}
  </div>
  <figcaption class="cap">
    <p class="cap-head">
      <b class="cap-no">图 {no}</b>
      <span class="cap-title">{title}</span>
    </p>
    <p class="cap-txt">{caption}</p>
  </figcaption>
</figure>

<style>
  .plate {
    align-self: start;       /* 不随行拉伸：版画井定高，行内多余高度留纸 */
    min-width: 0;
    margin: 0;
    border: 2px solid var(--ink);        /* 2px 钴蓝框体（M47 框线用蓝） */
    background: var(--paper);
    box-shadow: 8px 8px 0 var(--ink-14); /* 偏移实影（.card 同款） */
  }
  .well {
    position: relative;
    width: 100%;
  }
  .well img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* 占位井：虚线内框示意「版未上机」，内容居中，颜色走令牌 */
  .ph {
    position: absolute;
    inset: 12px;
    border: 1px dashed var(--ink-70);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 9px;
    text-align: center;
    padding: 0 14px;
  }
  .ph-tag {
    font-family: var(--mono);
    font-weight: 500;
    font-size: 12px;
    letter-spacing: .2em;
    color: var(--ink);                  /* kicker 家族标记，保留钴蓝 */
  }
  .ph-note {
    font-size: 12.5px;
    letter-spacing: .08em;
    color: var(--text-body);
  }
  .ph-file {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: .04em;
    color: var(--text-body);
    opacity: .8;
    overflow-wrap: anywhere;
  }
  /* 图注：框内下带，细线与版画井分隔；标题近黑、图号走钴蓝小标 */
  .cap {
    border-top: 1px solid var(--border);
    padding: 12px 14px 14px;
  }
  .cap-head {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .cap-no {
    font-family: var(--mono);
    font-weight: 500;
    font-size: 12px;
    letter-spacing: .14em;
    color: var(--ink);
    white-space: nowrap;
  }
  .cap-title {
    font-family: var(--serif);
    font-weight: 700;
    font-size: 15.5px;
    line-height: 1.5;
    color: var(--text);
  }
  .cap-txt {
    margin-top: 5px;
    font-size: 14px;                    /* v2 §2 小字档 */
    line-height: 1.75;
    color: var(--text-body);            /* 图注正文近黑 */
  }
</style>
