---
/**
 * 首页 SVG 场景，基座为 50-design/03-首页小样-OD/cordis-hero.html 的场景段：
 * 五块积木几何（坐标、rx 10、描边 2px）照搬小样，依赖曲线 1.6px 墨 .70。
 * 动效挂钩：[data-block] 五组（组内 .block-lit 为点亮态，04/05 另有 .block-off
 * 熄灭态色块，填充即令牌 --ink-14）、[data-dep] 依赖线组、[data-dep-path] 两条
 * 贝塞尔（描边动画走 stroke-dashoffset，铁律 1 的唯一例外）。
 * 动画只动 transform 与 opacity（铁律 1），五拍时序见 hero-motion.ts。
 */
---

<svg viewBox="0 0 780 620" role="img" data-hero-svg xmlns="http://www.w3.org/2000/svg" aria-labelledby="hero-scene-title">
  <title id="hero-scene-title">五块插件积木立于运行时基座上，中央数据库驱动向右侧两块插件伸出贝塞尔依赖曲线</title>

  <defs>
    <marker id="dep-arrowhead" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 Z" class="dep-arrow"></path>
    </marker>
  </defs>

  <!-- 贝塞尔依赖曲线：数据库驱动 → 查询插件 / 聊天插件（坐标出自 cordis-hero.html） -->
  <g data-dep>
    <path class="dep-curve" data-dep-path d="M 416 412 C 462 336, 512 402, 562 462" marker-end="url(#dep-arrowhead)"></path>
    <path class="dep-curve" data-dep-path d="M 416 412 C 484 268, 668 296, 698 434" marker-end="url(#dep-arrowhead)"></path>
    <text class="scene-note" x="502" y="300">依赖</text>
  </g>

  <!-- 积木 01 · 主题皮肤（独立块，全程点亮） -->
  <g data-block="01">
    <g class="block-lit">
      <rect class="block-box" x="36" y="452" width="138" height="108" rx="10"></rect>
      <text class="block-index" x="50" y="472">01</text>
      <text class="block-label" x="105" y="511">主题皮肤</text>
    </g>
  </g>

  <!-- 积木 02 · 日志器（独立块，全程点亮） -->
  <g data-block="02">
    <g class="block-lit">
      <rect class="block-box" x="198" y="482" width="104" height="78" rx="10"></rect>
      <text class="block-index" x="212" y="502">02</text>
      <text class="block-label" x="250" y="526">日志器</text>
    </g>
  </g>

  <!-- 积木 03 · 数据库驱动（中央核心，最高，第二拍被抬起抽出基座） -->
  <g data-block="03">
    <g class="block-lit">
      <rect class="block-box" x="326" y="412" width="156" height="148" rx="10"></rect>
      <text class="block-index" x="340" y="432">03</text>
      <text class="block-label core" x="404" y="492">数据库驱动</text>
    </g>
  </g>

  <!-- 积木 04 · 查询插件（依赖 03，第三拍连锁熄灭，第四拍复明） -->
  <g data-block="04">
    <rect class="block-off" x="506" y="468" width="112" height="92" rx="10"></rect>
    <g class="block-lit">
      <rect class="block-box" x="506" y="468" width="112" height="92" rx="10"></rect>
      <text class="block-index" x="520" y="488">04</text>
      <text class="block-label" x="562" y="519">查询插件</text>
    </g>
  </g>

  <!-- 积木 05 · 聊天插件（依赖 03，第三拍连锁熄灭，第四拍复明） -->
  <g data-block="05">
    <rect class="block-off" x="642" y="440" width="112" height="120" rx="10"></rect>
    <g class="block-lit">
      <rect class="block-box" x="642" y="440" width="112" height="120" rx="10"></rect>
      <text class="block-index" x="656" y="460">05</text>
      <text class="block-label" x="698" y="505">聊天插件</text>
    </g>
  </g>

  <!-- 浅墨基座横条（rx 4 与小样基座一致） -->
  <rect class="plinth" x="20" y="560" width="740" height="8" rx="4"></rect>
  <text class="scene-note" x="20" y="592">运行中的软件 · 运行时</text>
  <text class="scene-note" x="760" y="592" text-anchor="end">CORDIS RUNTIME</text>
</svg>
