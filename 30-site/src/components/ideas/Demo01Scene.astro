---
/**
 * 演示 01「撤销堆栈」静帧场景（占位壳：完整交互级本体属 M5，见 ideas-motion.ts）。
 * 几何与注记照搬 50-design/视觉稿/ideas/ideas.html 演示卡 01；
 * 场景词汇类（block-box / dep-curve 等）由 ideas.astro 页级样式统一供给。
 * 动效挂钩预留：动作按钮组 [data-d1-actions]、栈体 [data-d1-stack]。
 */
---

<svg viewBox="0 0 700 436" role="img" aria-labelledby="d1-title" data-d1-svg xmlns="http://www.w3.org/2000/svg">
  <title id="d1-title">撤销堆栈静帧：左侧三个动作按钮，右侧一叠动作卡片压在基座上，栈顶卡片挂着撤销函数小签</title>
  <defs>
    <marker id="d1-arrow" viewBox="0 0 10 10" refX="8" refY="5"
            markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 Z" class="dep-arrow"></path>
    </marker>
  </defs>
  <text class="scene-note" x="28" y="44">动作按钮 · 键名 rename-title / register-service / write-counter</text>
  <text class="scene-note" x="672" y="44" text-anchor="end">静帧 · 第 0 帧</text>
  <g data-d1-actions>
    <rect class="block-box" x="28" y="78" width="150" height="56" rx="10"></rect>
    <text class="block-label" x="103" y="112">改标题</text>
    <rect class="block-box" x="28" y="158" width="150" height="56" rx="10"></rect>
    <text class="block-label" x="103" y="192">注册服务</text>
    <rect class="block-box" x="28" y="238" width="150" height="56" rx="10"></rect>
    <text class="block-label" x="103" y="272">写计数器</text>
  </g>
  <path class="dep-curve" d="M 182 106 C 260 106, 284 183, 342 183" marker-end="url(#d1-arrow)"></path>
  <text class="scene-mono" x="238" y="92">track · 边干活边记账</text>
  <g data-d1-stack>
    <rect class="block-box" x="384" y="296" width="240" height="78" rx="10"></rect>
    <line class="thin-line" x1="408" y1="324" x2="560" y2="324"></line>
    <line class="thin-line" x1="408" y1="348" x2="536" y2="348"></line>
    <rect class="block-box" x="366" y="220" width="240" height="78" rx="10"></rect>
    <line class="thin-line" x1="390" y1="248" x2="542" y2="248"></line>
    <rect class="block-box" x="348" y="144" width="240" height="78" rx="10"></rect>
    <rect class="block-box" x="512" y="120" width="96" height="30" rx="6"></rect>
    <text class="block-label sm" x="560" y="140">撤销函数</text>
  </g>
  <rect class="plinth" x="24" y="396" width="652" height="8" rx="4"></rect>
  <text class="scene-note" x="24" y="426">共享语境 · 账本</text>
  <text class="scene-note" x="676" y="426" text-anchor="end">UNDO STACK</text>
</svg>
