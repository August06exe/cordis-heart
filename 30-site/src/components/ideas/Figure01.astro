---
/**
 * 图 01「独立性与交换性」静态对比图（思想四）。
 * 几何照搬 50-design/视觉稿/ideas/ideas.html 图 01；<title> 取文稿 ideas.md
 * 的图说（左联 / 右联描述），供读屏与无 JS 场景。纯静态，无动效挂钩。
 */
---

<svg viewBox="0 0 620 404" role="img" aria-labelledby="f1-title" data-f1-svg xmlns="http://www.w3.org/2000/svg">
  <title id="f1-title">图 01 静态对比图（两联）：左联两个组件各写各的键，先后无所谓，抽掉一条，别的照常工作；右联两个操作排在同一条有序链上，插在别人前面，改变对方看到的请求</title>
  <defs>
    <marker id="f1-arrow" viewBox="0 0 10 10" refX="8" refY="5"
            markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 Z" class="dep-arrow"></path>
    </marker>
  </defs>
  <line class="thin-line" x1="310" y1="28" x2="310" y2="376"></line>
  <g data-f1-commutative>
    <text class="panel-title" x="32" y="54">可交换</text>
    <text class="scene-note" x="32" y="78">注册表形状</text>
    <rect class="block-box" x="36" y="104" width="104" height="70" rx="10"></rect>
    <text class="block-label" x="88" y="144">组件 A</text>
    <rect class="block-box" x="188" y="104" width="104" height="70" rx="10"></rect>
    <text class="block-label" x="240" y="144">组件 B</text>
    <path class="dep-curve" d="M 88 174 L 88 220" marker-end="url(#f1-arrow)"></path>
    <path class="dep-curve" d="M 240 174 L 240 220" marker-end="url(#f1-arrow)"></path>
    <rect class="block-box" x="60" y="228" width="56" height="56" rx="8"></rect>
    <text class="cell-label" x="88" y="261" text-anchor="middle">键 a</text>
    <rect class="block-box" x="212" y="228" width="56" height="56" rx="8"></rect>
    <text class="cell-label" x="240" y="261" text-anchor="middle">键 b</text>
    <text class="scene-note" x="32" y="348">先后无所谓；抽掉一条，别的照常工作</text>
  </g>
  <g data-f1-ordered>
    <text class="panel-title" x="342" y="54">不可交换</text>
    <text class="scene-note" x="342" y="78">中间件链形状</text>
    <rect class="block-box" x="338" y="120" width="64" height="56" rx="10"></rect>
    <text class="block-label sm" x="370" y="153">请求</text>
    <path class="dep-curve" d="M 402 148 L 430 148" marker-end="url(#f1-arrow)"></path>
    <rect class="block-box" x="436" y="120" width="72" height="56" rx="10"></rect>
    <text class="block-label sm" x="472" y="153">操作 A</text>
    <path class="dep-curve" d="M 508 148 L 536 148" marker-end="url(#f1-arrow)"></path>
    <rect class="block-box" x="542" y="120" width="66" height="56" rx="10"></rect>
    <text class="block-label sm" x="575" y="153">操作 B</text>
    <text class="scene-note" x="342" y="348">插在别人前面，改变对方看到的请求</text>
  </g>
</svg>
