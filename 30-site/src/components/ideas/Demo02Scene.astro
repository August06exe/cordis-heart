---
/**
 * 演示 02「生命周期状态机」静帧场景（占位壳：完整交互级本体属 M5，见 ideas-motion.ts）。
 * 几何与注记照搬 50-design/视觉稿/ideas/ideas.html 演示卡 02；
 * 场景词汇类由 ideas.astro 页级样式统一供给。
 * 动效挂钩预留：依赖表 [data-d2-table]、分类器 [data-d2-classifier]、
 * 三分类出口 [data-d2-exits]、组件积木 [data-d2-component]、触发按钮 [data-d2-buttons]。
 */
---

<svg viewBox="0 0 720 436" role="img" aria-labelledby="d2-title" data-d2-svg xmlns="http://www.w3.org/2000/svg">
  <title id="d2-title">生命周期状态机静帧：左侧环境依赖表列着数据库与缓存两个键，中间分类器把每次变化分成三类，右侧组件积木挂着营业中的牌子立于基座，下方一排四枚触发按钮</title>
  <defs>
    <marker id="d2-arrow" viewBox="0 0 10 10" refX="8" refY="5"
            markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 Z" class="dep-arrow"></path>
    </marker>
  </defs>
  <text class="scene-note" x="28" y="44">环境依赖表</text>
  <text class="scene-note" x="692" y="44" text-anchor="end">静帧 · 第 0 帧</text>
  <g data-d2-table>
    <rect class="block-box" x="28" y="60" width="190" height="236" rx="10"></rect>
    <line class="thin-line" x1="28" y1="118" x2="218" y2="118"></line>
    <text class="cell-label" x="52" y="152">数据库</text>
    <rect class="ghost-box" x="138" y="132" width="56" height="28" rx="6"></rect>
    <line class="thin-line" x1="28" y1="190" x2="218" y2="190"></line>
    <text class="cell-label" x="52" y="224">缓存</text>
    <rect class="ghost-box" x="138" y="204" width="56" height="28" rx="6"></rect>
  </g>
  <path class="dep-curve" d="M 222 178 C 252 178, 268 190, 296 190" marker-end="url(#d2-arrow)"></path>
  <g data-d2-classifier>
    <rect class="block-box" x="300" y="140" width="120" height="130" rx="10"></rect>
    <text class="block-label" x="360" y="196">分类器</text>
    <text class="scene-note" x="360" y="222" text-anchor="middle">对照规格</text>
  </g>
  <g data-d2-exits>
    <path class="dep-curve" d="M 420 166 L 434 166" marker-end="url(#d2-arrow)"></path>
    <text class="scene-mono" x="442" y="170">activating</text>
    <path class="dep-curve" d="M 420 205 L 434 205" marker-end="url(#d2-arrow)"></path>
    <text class="scene-mono" x="442" y="209">deactivating</text>
    <path class="dep-curve" d="M 420 244 L 434 244" marker-end="url(#d2-arrow)"></path>
    <text class="scene-mono" x="442" y="248">neutral</text>
  </g>
  <g data-d2-component>
    <line class="thin-line" x1="592" y1="126" x2="592" y2="150"></line>
    <line class="thin-line" x1="632" y1="126" x2="632" y2="150"></line>
    <rect class="block-box" x="572" y="92" width="80" height="34" rx="6"></rect>
    <text class="block-label sm" x="612" y="114">营业中</text>
    <rect class="block-box" x="556" y="150" width="112" height="116" rx="10"></rect>
    <text class="block-label" x="612" y="212">组件</text>
  </g>
  <text class="scene-note" x="28" y="330">四态按钮 · 键名 write-key / delete-key / neutral-change / supply-cut</text>
  <g data-d2-buttons>
    <rect class="block-box" x="28" y="340" width="148" height="48" rx="10"></rect>
    <text class="block-label" x="102" y="370">写键</text>
    <rect class="block-box" x="200" y="340" width="148" height="48" rx="10"></rect>
    <text class="block-label" x="274" y="370">删键</text>
    <rect class="block-box" x="372" y="340" width="148" height="48" rx="10"></rect>
    <text class="block-label" x="446" y="370">无关变化</text>
    <rect class="block-box" x="544" y="340" width="148" height="48" rx="10"></rect>
    <text class="block-label" x="618" y="370">断供连锁</text>
  </g>
  <rect class="plinth" x="24" y="396" width="672" height="8" rx="4"></rect>
  <text class="scene-note" x="24" y="426">环境变化 · 逐次对照</text>
  <text class="scene-note" x="696" y="426" text-anchor="end">LIFECYCLE</text>
</svg>
