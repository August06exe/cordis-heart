---
/**
 * 打法卡（M4.5 v2 重排：15 条打法改 .card 原语，2 列栅格，见页级 steal-this.astro）。
 * .card = 2px 墨线 + 纸底 + 8px 偏移实影 + 22px 内边距（global.css 原语）；
 * 选中反馈 = 实影转实印（8px 8px 0 墨），不加底色块、不引第二色相。
 * 真实 checkbox + label 可键盘操作；标题走 h3 档（20px serif 900 实墨），
 * 大白话走正文档（17.5px / 1.9 / 实墨），出处行用 SourceLine（Badge + 依据浮层）。
 * 卡内视觉承载：条目号（mono）+ 勾选框图形（v2 §4 卡内须有数字或图形）。
 *
 * 分镜注记：勾选 change 事件由 steal-this.ts 统一切换 is-on 与计数，
 * 生成器块插入与移除挂同一事件钩子（见 GenPanel.astro 注释）。
 */
import type { StealItem } from './items';
import SourceLine from './SourceLine.astro';

interface Props {
  item: StealItem;
}

const { item } = Astro.props;
const cbxId = `st-idea-${item.n}`;
---

<article class="st-card card" data-idea-item data-pop-scope>
  <input type="checkbox" class="st-cbx" id={cbxId} data-idea-cbx={item.n} />
  <label for={cbxId}>
    <span class="row">
      <span class="box" aria-hidden="true"><span class="tick"></span></span>
      <span class="num">{item.n}</span>
    </span>
    <span class="t">{item.title}</span>
    <span class="d">{item.plain}</span>
  </label>
  <SourceLine variant="row" level={item.level} source={item.source} basis={item.why} uid={`row-${item.n}`} />
</article>

<style>
  .st-card {
    position: relative;
    z-index: 0;
    display: flex;
    flex-direction: column;
    transition: box-shadow .14s ease;
  }
  .st-card.is-on { box-shadow: 8px 8px 0 var(--ink); }
  /* 展开浮层的条目抬层，防止被后绘卡盖住（M4 同款处理） */
  .st-card.is-pop-open { z-index: 2; }

  .st-cbx {
    position: absolute;
    opacity: 0;
    width: 20px;
    height: 20px;
    left: var(--card-pad);
    top: calc(var(--card-pad) + 2px);
    margin: 0;
  }
  .st-cbx:focus-visible { outline: none; }
  .st-cbx:focus-visible + label .box {
    outline: 2px solid var(--focus-ring);
    outline-offset: 3px;
  }

  label {
    display: flex;
    flex-direction: column;
    cursor: pointer;
  }
  .row {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .box {
    flex: 0 0 auto;
    width: 20px;
    height: 20px;
    border: 1.5px solid var(--ink-70);
    background: transparent;
    position: relative;
    transition: border-color .14s ease, background-color .14s ease;
  }
  label:hover .box { border-color: var(--ink); }
  .tick {
    position: absolute;
    left: 4.5px;
    top: 1.5px;
    width: 6px;
    height: 11px;
    border-right: 2px solid var(--paper);
    border-bottom: 2px solid var(--paper);
    transform: rotate(42deg) scale(0);
    transform-origin: 50% 50%;
    transition: transform .14s ease;
  }
  .is-on .box { background: var(--ink); border-color: var(--ink); }
  .is-on .tick { transform: rotate(42deg) scale(1); }

  .num {
    font-family: var(--mono);
    font-weight: 500;
    font-size: 14px;
    letter-spacing: .14em;
    color: var(--ink-80);
    transition: color .14s ease;
  }
  .is-on .num { color: var(--ink); }

  .t {
    display: block;
    margin-top: 10px;
    font-family: var(--serif);
    font-weight: 900;
    font-size: 20px;
    line-height: 1.5;
    letter-spacing: .01em;
    color: var(--ink);
  }
  .d {
    display: block;
    margin-top: 8px;
    font-size: 17.5px;
    line-height: 1.9;
    color: var(--text-body);
  }
  /* 出处行沉底：卡高随同行拉齐时出处行贴下缘 */
  .st-card :global(.st-src) { margin-top: auto; }
  .st-card :global(.st-src-row) { margin-top: 12px; }

  @media (prefers-reduced-motion: reduce) {
    .st-card, .box, .tick, .num { transition: none; }
  }
</style>
