---
/**
 * 章节翻页器（基座组件）：按 src/data/site.ts 的 SITE_PAGES 顺序，
 * 给出当前页的上一篇 / 下一篇，两个大按钮占阅读栏全宽，<960px 塌堆叠。
 * 挂载点在 BaseLayout 的 book 壳阅读栏底部；样式在 global.css 的 .page-pager 段
 * （2px 墨线框体 + hover 实底反白；「上一篇/下一篇」label 属 kicker 家族保留钴蓝）。
 * slug 口径与 BaseLayout 一致：首页 '/'，内容页 'why' 等；首/末篇缺省侧不渲染按钮。
 */
import { SITE_PAGES, type SitePage } from '../data/site';

interface Props {
  /** 当前页 slug，与 SITE_PAGES.slug 对齐（首页 '/'） */
  slug: string;
}

const { slug } = Astro.props;

// 与 BaseLayout 的 here 同口径归一（去首尾斜杠，首页特判），避免归一差导致定位失败
const norm = (s: string): string => (s === '/' ? '/' : s.replace(/^\/+|\/+$/g, ''));
const me = SITE_PAGES.findIndex((p) => norm(p.slug) === norm(slug));
if (me === -1) {
  throw new Error(`[PagePager] SITE_PAGES 里找不到 slug="${slug}"，翻页器无法定位章节序`);
}

const prev: SitePage | undefined = SITE_PAGES[me - 1];
const next: SitePage | undefined = SITE_PAGES[me + 1];
---

{(prev || next) && (
  <nav class="page-pager" aria-label="章节翻页">
    {prev && (
      <a class="pp-btn" href={prev.path} rel="prev">
        <span class="pp-label">上一篇</span>
        <span class="pp-title">{prev.title}</span>
      </a>
    )}
    {next && (
      <a class="pp-btn" href={next.path} rel="next">
        <span class="pp-label">下一篇</span>
        <span class="pp-title">{next.title}</span>
      </a>
    )}
  </nav>
)}
